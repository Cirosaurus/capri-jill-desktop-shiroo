<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>Capri Setup</AssemblyTitle>
    <AssemblyDescription>Capri Desktop Companion Installer</AssemblyTitle>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\chip.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Setup.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\chip.ico">
      <Link>chip.ico</Link>
      <LogicalName>Capri.Chip.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\chip.png">
      <Link>chip.png</Link>
      <LogicalName>Capri.Chip.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing.Common" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>